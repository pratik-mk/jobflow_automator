# Cursor SDK key - used for job rating and resume tailoring
CURSOR_API_KEY=cursor_...

# Google Sheets (share the sheet with the service account email as Editor)
GOOGLE_SHEETS_CREDENTIALS_FILE=config/credentials.json
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/...

# Storage: primary is the source of truth, mirrors receive a copy of every write
STORE_PRIMARY=sheets
STORE_MIRRORS=sqlite
SQLITE_PATH=data/jobs.db
